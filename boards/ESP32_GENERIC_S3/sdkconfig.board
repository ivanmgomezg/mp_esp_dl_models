CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

# This config is enabled in esp-dl examples and probaly gives a better performance,
# but it is not compatibe with MicroPython at the moment (MicroPython 1.25; IDF 5.4.1).
# CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Needed for better AI performance
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=40

# A8 compilación 1: liberar RAM interna para Wi-Fi/lwIP
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4

# A9: modelo de reconocimiento facial MBF_S8_V1 en vez de MFN_S8_V1.
# Se carga desde la microSD (mount point /sd) en vez de ir embebido en la
# partición factory: MBF pesa ~3,4 MB contra ~1,2 MB de MFN, y no entra
# junto con el resto del firmware en la partición actual.
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_RODATA=
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_SDCARD=y
CONFIG_HUMAN_FACE_FEAT_MFN_S8_V1=
CONFIG_HUMAN_FACE_FEAT_MBF_S8_V1=y
